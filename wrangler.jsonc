{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eccho-pr-reviewer",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Retention window for the scheduled storage cleanup (days).
  "vars": {
    "FLUE_RETENTION_DAYS": "30",
    // Cooldown (seconds) before a burst of pushes is reviewed once as a whole.
    "FLUE_SYNCHRONIZE_COOLDOWN_SECONDS": "300"
  },

  // Daily cleanup: prune stale GitHub-conversation state and trigger retention
  // cleanup on agent instances whose conversations are closed or idle.
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  // Application-owned Durable Object: GitHub conversation state (admission
  // dedup + lifecycle). Export + class live in src/cloudflare.ts.
  "durable_objects": {
    "bindings": [
      { "name": "FLUE_GITHUB_STATE", "class_name": "FlueGithubState" }
    ]
  },

  // Workers Logs — so background agent work is visible (`wrangler tail` / dashboard).
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // Never rewrite applied migration history. v1 + v2 were deployed (the old
  // container version); v3 retires the now-removed Sandbox container class.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FlueRegistry",
        "FluePrReviewerAgent",
        "FlueReviewPullRequestWorkflow"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["Sandbox"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["FlueIssueClassifierAgent", "FlueIssueTriagerAgent"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["FlueTriageBacklogWorkflow"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["FlueGithubState"]
    }
  ]
}
