{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eccho-pr-reviewer",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers Logs — so background agent work is visible (`wrangler tail` / dashboard).
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  // Never rewrite applied migration history. v1 + v2 were deployed (the old
  // container version); v3 retires the now-removed Sandbox container class.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FlueRegistry",
        "FluePrReviewerAgent",
        "FlueReviewPullRequestWorkflow"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["Sandbox"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["FlueIssueClassifierAgent", "FlueIssueTriagerAgent"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["FlueTriageBacklogWorkflow"]
    }
  ]
}
